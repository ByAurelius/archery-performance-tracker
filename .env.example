# Copy this file to .env and fill in the values. .env is never committed to Git.

# Secret key used to sign login sessions. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# 1 = debug mode with auto-reload, only for local development. Keep it 0 otherwise:
# the Werkzeug debugger lets anyone who can reach the page run arbitrary code.
FLASK_DEBUG=0

# Code a new user must enter on the sign-up page to get a coach account.
# Share it only with coaches. Leave it empty to block coach sign-ups completely.
COACH_INVITE_CODE=change-me
